# Copier vers .env.local (jamais commité). Aucune valeur secrète ici.
# Valeurs : tableau de bord Supabase > Project Settings > API (ou `npx supabase status` en local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clé "publishable" (sb_publishable_...) : publique par conception, protégée par les RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NE JAMAIS mettre la clé secrète / service_role dans une variable NEXT_PUBLIC_.
# Si un jour nécessaire côté serveur uniquement : SUPABASE_SECRET_KEY= (Vercel > Environment Variables)
